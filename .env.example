# Admin config (copy to .env.local for dev, set on Vercel for prod)
# Username for the admin dashboard login
ADMIN_USERNAME=admin

# EITHER set a plaintext password (dev convenience — hashed at boot):
ADMIN_PASSWORD=IdeaForge@BD2024!xK9wQ
# OR set a pre-hashed password (preferred for production):
# ADMIN_PASSWORD_HASH=<run: bun scripts/hash-password.ts>

# Session signing secret — any long random string (32+ chars recommended)
# Generate one: openssl rand -hex 32
ADMIN_SESSION_SECRET=ideaforge-bd-dev-session-secret-do-not-use-in-production-0xK9wQ

# (Legacy, optional) Prisma SQLite URL — no longer used by the app but
# kept for backwards compatibility with the seed script.
DATABASE_URL=file:./db/custom.db
